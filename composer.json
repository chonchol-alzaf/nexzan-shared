{
    "name": "nexzan/shared",
    "description": "Shared utility package for Nexzan platform",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nexzan\\Shared\\": "src/"
        },
        "files": [
            "src/Supports/helpers.php"
        ]
    },

    "require": {
        "php": ">=8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "php-amqplib/php-amqplib": "^3.7",
        "firebase/php-jwt": "^7.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexzan\\Shared\\Providers\\NexzanSharedServiceProvider"
            ]
        }
    }
}
